DATA_AGENT_CONTROL_DATABASE_URL=sqlite+aiosqlite:///./data/control.db
DATA_AGENT_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# 与旧 Python 后端共用本机 product_db；部署时请替换为专用只读账号。
DATA_AGENT_PRODUCT_DATABASE_URL=mysql+pymysql://root:admin@127.0.0.1:3306/product_db
# 生产多租户模式使用 JSON 映射；配置后未列出的租户不会获得业务库连接。
DATA_AGENT_TENANT_DATABASE_URLS={}
DATA_AGENT_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# 也可以直接复用旧 Python 后端的 DATA_AGENT_LLM_API_KEY 环境变量。
DATA_AGENT_ANTHROPIC_API_KEY=replace-me
DATA_AGENT_CLAUDE_MODEL=deepseek-v4-flash
# 旧配置命名也支持：DATA_AGENT_LLM_MODEL=deepseek-v4-flash
DATA_AGENT_RESULT_DIR=./data/results
DATA_AGENT_WORKSPACE_DIR=./data/workspaces
DATA_AGENT_MAX_SQL_ROWS=50000
DATA_AGENT_SQL_TIMEOUT_SECONDS=30
DATA_AGENT_SSE_HEARTBEAT_SECONDS=15
DATA_AGENT_MAX_AGENT_TURNS=30
# 默认关闭扩展思考；只有供应商确认支持时才改为 true。
DATA_AGENT_THINKING_ENABLED=false
DATA_AGENT_PYTHON_SANDBOX_IMAGE=data-agent-python-sandbox:latest
DATA_AGENT_PYTHON_SANDBOX_TIMEOUT_SECONDS=60
DATA_AGENT_ALLOWED_SENSITIVE_FIELDS=
DATA_AGENT_OTEL_ENABLED=false
